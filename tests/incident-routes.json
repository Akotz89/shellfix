[
  {
    "name": "explicit wsl bash chain",
    "command": "wsl -d Ubuntu-24.04 -- bash -c \"echo ok && python3 -c 'print(list(range(5))[1:-1])'\"",
    "expectedRoute": "wsl-direct",
    "source": "powershell-command-primary-clusters:wsl-bash-c"
  },
  {
    "name": "wsl python heredoc stdin",
    "command": "wsl -d Ubuntu-24.04 -- python3 << 'PYEOF'\nimport json\nprint('servers', sorted({'b': 2, 'a': 1}.keys()))\nPYEOF",
    "expectedRoute": "wsl-direct",
    "source": "command-shape-backlog:wsl-heredoc-stdin"
  },
  {
    "name": "wsl node heredoc stdin",
    "command": "wsl -d Ubuntu-24.04 -- node << 'NODE'\nconsole.log(['a','b'].join(','))\nNODE",
    "expectedRoute": "wsl-direct",
    "source": "command-shape-backlog:wsl-node-heredoc-stdin"
  },
  {
    "name": "wsl bash heredoc",
    "command": "wsl -d Ubuntu-24.04 -- bash -lc \"python3 - <<'PY'\nprint('bash heredoc ok')\nPY\"",
    "expectedRoute": "wsl-direct",
    "source": "command-shape-backlog:wsl-bash-heredoc"
  },
  {
    "name": "wsl bash stdin heredoc",
    "command": "wsl -d Ubuntu-24.04 -- bash -s <<'BASH'\necho bash-stdin-ok\nBASH",
    "expectedRoute": "wsl-direct",
    "source": "planned-regression:wsl-bash-s-heredoc"
  },
  {
    "name": "wsl bash nested multiple heredocs",
    "command": "wsl -d Ubuntu-24.04 -- bash -c \"cat > /tmp/shellfix_a.txt <<'EOF1'\none\nEOF1\ncat > /tmp/shellfix_b.txt <<'EOF2'\ntwo\nEOF2\ncat /tmp/shellfix_a.txt /tmp/shellfix_b.txt\"",
    "expectedRoute": "wsl-direct",
    "source": "planned-regression:multiple-bash-heredocs"
  },
  {
    "name": "cmd wrapper wsl",
    "command": "cmd /c \"wsl -d Ubuntu-24.04 -- bash -c \\\"echo cmd-wsl-ok\\\"\"",
    "expectedRoute": "wsl-direct",
    "source": "planned-regression:cmd-wrapper-wsl"
  },
  {
    "name": "cmd wrapper npx",
    "command": "cmd /c npx -y npm@latest --version",
    "expectedRoute": "native-direct",
    "source": "planned-regression:cmd-wrapper-native"
  },
  {
    "name": "wsl json curl payload",
    "command": "wsl -d Ubuntu-24.04 -- bash -c \"printf '{\\\"jsonrpc\\\":\\\"2.0\\\",\\\"id\\\":1}' > /tmp/shellfix_mcp.json && cat /tmp/shellfix_mcp.json\"",
    "expectedRoute": "wsl-direct",
    "source": "command-shape-backlog:wsl-json-curl-payload"
  },
  {
    "name": "wsl venv multiline python property lookup",
    "command": "wsl -d Ubuntu-24.04 -- bash -c \"/home/aaron/.venvs/diagrams/bin/python -c \\\"\nclass O: pass\no = O()\nprint(type(type(o).__dict__.get('container', None)))\n\\\"\"",
    "expectedRoute": "wsl-direct",
    "source": "antigravity-screenshot:wsl-venv-inline-python"
  },
  {
    "name": "native multiline python regex",
    "command": "python -c \"import re\nfor m in re.finditer(r'https?://[^\\s\\'\\\",)]+', 'https://example.com/path'):\n    print(m.group())\n\"",
    "expectedRoute": "native-inline-tempfile",
    "source": "powershell-command-primary-clusters:native-inline-python"
  },
  {
    "name": "py launcher version switch",
    "command": "py -3 -c \"print('ok')\"",
    "expectedRoute": "native-inline-tempfile",
    "source": "planned-regression:py-version-switch"
  },
  {
    "name": "native node inline",
    "command": "node -e \"console.log(process.execPath)\"",
    "expectedRoute": "native-inline-tempfile",
    "source": "powershell-command-primary-clusters:native-inline-node"
  },
  {
    "name": "d2 stderr redirect",
    "command": "& \"{{d2}}\" \"input.d2\" \"output.png\" 2>&1",
    "expectedRoute": "native-direct",
